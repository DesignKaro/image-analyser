OPENAI_API_KEY=sk-your-openai-key
HOST=127.0.0.1
PORT=8787
OPENAI_MODEL=gpt-4o-mini
# OPENAI_API_URL=https://api.openai.com/v1/chat/completions
# OPENAI_TIMEOUT_MS=45000
# MAX_BODY_BYTES=18874368

# Phase 1 SaaS
# When the server is behind a proxy at a path (e.g. /backend), set BASE_PATH so auth/api routes match:
# BASE_PATH=/backend
MYSQL_HOST=srv1828.hstgr.io
MYSQL_PORT=3306
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=your_mysql_database
AUTH_SECRET=change-this-to-a-long-random-secret
SAAS_AUTH_REQUIRED=false
# Auth token lifetime in seconds (minimum enforced at 604800 = 7 days)
TOKEN_TTL_SECONDS=2592000
GUEST_MONTHLY_LIMIT=20
GUEST_KEY_SALT=change-this-guest-salt
GOOGLE_CLIENT_ID=your_google_oauth_client_id
# Must match web NEXT_PUBLIC_GOOGLE_CLIENT_ID for Google login to work.
# Use a Google OAuth "Web application" client ID with allowed origin(s), e.g.:
# http://localhost:3000, https://img.connectiqworld.cloud
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Anti-abuse auth controls
# BLOCK_DISPOSABLE_EMAILS=true
# SIGNUP_MIN_FORM_FILL_MS=1500
# SIGNUP_MAX_FORM_AGE_MS=43200000
# AUTH_RATE_LIMIT_WINDOW_MS=600000
# AUTH_SIGNUP_MAX_ATTEMPTS_PER_IP=8
# AUTH_SIGNUP_MAX_ATTEMPTS_PER_EMAIL=4
# AUTH_SIGNUP_MAX_REGISTRATIONS_PER_IP=6
# AUTH_SIGNIN_MAX_ATTEMPTS_PER_IP=30
# AUTH_SIGNIN_MAX_ATTEMPTS_PER_EMAIL=12
# AUTH_GOOGLE_MAX_ATTEMPTS_PER_IP=25
# AUTH_GOOGLE_MAX_ATTEMPTS_PER_EMAIL=10
# AUTH_ENFORCE_EMAIL_DNS=true
# AUTH_EMAIL_DNS_FAIL_OPEN=false
# AUTH_EMAIL_DNS_TIMEOUT_MS=3000
# AUTH_EMAIL_DNS_CACHE_SUCCESS_MS=21600000
# AUTH_EMAIL_DNS_CACHE_FAILURE_MS=1200000
# Optional bootstrap admins (comma-separated). Existing users are elevated to admin on startup.
# BOOTSTRAP_ADMIN_EMAILS=imagetopromptgenerate@gmail.com
# Optional password used only when a bootstrap admin email does not exist yet.
# BOOTSTRAP_ADMIN_PASSWORD=ChangeThisAdminPass123!

# Billing / Razorpay (test mode defaults)
APP_BASE_URL=http://localhost:3000
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_test_key_secret
# RAZORPAY_API_BASE=https://api.razorpay.com/v1
# RAZORPAY_WEBHOOK_SECRET=whsec_xxx
# RAZORPAY_CURRENCY=USD
# DEFAULT_PRICING_CURRENCY=USD
# USD_TO_INR_RATE=83
# MODEL_COST_USD_CENTS_PER_PROMPT=2
# PROMPT_PRICE_MULTIPLIER=5
# FREE_MONTHLY_PROMPT_QUOTA=20
# PRO_MONTHLY_PROMPT_QUOTA=200
# RAZORPAY_PRO_AMOUNT_SUBUNITS=2000
# RAZORPAY_PRO_ANNUAL_AMOUNT_SUBUNITS=19200
# Legacy only (for existing Unlimited users):
# RAZORPAY_UNLIMITED_AMOUNT_SUBUNITS=6000
# RAZORPAY_UNLIMITED_ANNUAL_AMOUNT_SUBUNITS=57600
